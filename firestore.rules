rules_version = '2';

// AegisSage — HIPAA-aligned Firestore security rules
//
// Isolation model:
//   phi_vault/{agencyId}/...  — encrypted PHI; only authenticated members of that agency
//   clients/{memberId}        — operational metadata; any authenticated agency member whose agencyId matches
//   vaults/{userId}           — legacy per-user settings vault
//
// Custom claim required: request.auth.token.agencyId must be set on login via
// Firebase Admin SDK (server-side) to enforce agency-level isolation.

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function callerAgencyId() {
      return request.auth.token.agencyId;
    }

    function isAgencyMember(agencyId) {
      return isAuthenticated() && callerAgencyId() == agencyId;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -----------------------------------------------------------------------
    // phi_vault — HIPAA-isolated PHI store
    //
    // Core gate: request.auth.token.agencyId == resource.data.agencyId
    // A broker from agency A can never read or write data owned by agency B,
    // even if they know the document path.
    //
    // Parent document (/{agencyId}) is intentionally write-blocked so no
    // unencrypted data can be written to the collection root.
    // -----------------------------------------------------------------------

    match /phi_vault/{agencyId} {
      allow read, write: if false;

      // Encrypted PHI records.
      // read:   token claim must match the agencyId stored on the document.
      // create/update: token claim must match the agencyId being written,
      //   which must also equal the path segment and carry required cipher fields.
      match /records/{memberId} {
        allow read: if isAuthenticated()
          && request.auth.token.agencyId == resource.data.agencyId;

        allow create, update: if isAuthenticated()
          && request.auth.token.agencyId == request.resource.data.agencyId
          && request.resource.data.agencyId == agencyId
          && request.resource.data.memberId == memberId
          && request.resource.data.cipher is string
          && request.resource.data.iv is string
          && request.resource.data.encryptedBy == request.auth.uid
          && request.resource.data.encryptedAt is int;

        // PHI deletion must go through the Admin SDK (server-side only).
        allow delete: if false;
      }

      // Audit log — append-only. Updates and deletes are never permitted;
      // the audit chain must be immutable (HIPAA §164.312(b)).
      match /audit_log/{entryId} {
        allow read: if isAuthenticated()
          && request.auth.token.agencyId == resource.data.agencyId;

        allow create: if isAuthenticated()
          && request.auth.token.agencyId == request.resource.data.agencyId
          && request.resource.data.agencyId == agencyId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.timestamp is int
          && request.resource.data.hash is string;

        allow update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // clients — operational metadata, no PHI.
    //
    // Core gate: request.auth.token.agencyId == resource.data.agencyId
    // On create, resource does not yet exist so we check request.resource instead.
    // On update, both the existing doc and the incoming payload must match the
    // caller's claim — preventing data from being moved between agencies.
    // -----------------------------------------------------------------------

    match /clients/{memberId} {
      allow read: if isAuthenticated()
        && request.auth.token.agencyId == resource.data.agencyId;

      allow create: if isAuthenticated()
        && request.auth.token.agencyId == request.resource.data.agencyId;

      allow update: if isAuthenticated()
        && request.auth.token.agencyId == resource.data.agencyId
        && request.auth.token.agencyId == request.resource.data.agencyId;

      // Soft-delete pattern: set status = 'archived' instead of deleting.
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // invitations — agency owner creates invite; Cloud Function marks accepted.
    // The Cloud Function uses Admin SDK and bypasses these rules for its writes.
    // -----------------------------------------------------------------------

    match /invitations/{inviteId} {
      // Agency members can read invitations for their agency (e.g. list pending invites in UI).
      allow read: if isAuthenticated()
        && resource.data.agencyId == callerAgencyId();

      // Only authenticated agency members can create invitations for their own agency.
      allow create: if isAuthenticated()
        && request.resource.data.agencyId == callerAgencyId()
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string;

      // Clients never update or delete — the Cloud Function handles status transitions.
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // users — pre-populated by onboarding or admin before account creation.
    // The Cloud Function reads users/{uid} to set agencyId for self-registered owners.
    // -----------------------------------------------------------------------

    match /users/{uid} {
      // Users can read their own profile.
      allow read: if isOwner(uid);

      // Agency owners can pre-create user docs for incoming members before sign-up.
      allow create: if isAuthenticated()
        && request.resource.data.agencyId == callerAgencyId();

      // Users can update their own doc; agency members can update docs in their agency.
      allow update: if isOwner(uid)
        || (isAuthenticated() && resource.data.agencyId == callerAgencyId());

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // vaults — legacy per-user encrypted settings (agencyProfile, GHL, Maya)
    // Kept for backward compatibility with the Hydra PHI Vault page.
    // -----------------------------------------------------------------------

    match /vaults/{userId} {
      allow read, write: if isOwner(userId);
    }

    // -----------------------------------------------------------------------
    // notifications — high-risk alerts written by onClientRiskChange function.
    // Brokers can read their own notifications; all writes go through Admin SDK.
    // -----------------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && resource.data.brokerId == request.auth.uid;

      // Writes are Cloud Function only (Admin SDK bypasses rules).
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // audit_logs — top-level claim-assignment audit trail.
    // Written exclusively by the setAgencyClaim Cloud Function via Admin SDK.
    // Agency members can read their own agency's entries; no client writes.
    // -----------------------------------------------------------------------

    match /audit_logs/{entryId} {
      allow read: if isAuthenticated()
        && resource.data.agencyId == callerAgencyId();

      // All writes go through the Admin SDK (Cloud Function only).
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // members — Integrity Engine encrypted member records.
    //
    // Isolation model: request.auth.uid == resource.data.brokerId
    // Each broker can only read and write their own members. No admin or
    // agency-owner can perform a bulk read across all broker data.
    //
    // Writes are validated to require all three cipher fields, ensuring the
    // client cannot store plaintext PHI.
    //
    // PHI deletion is blocked client-side; use Admin SDK with a logged
    // workflow for HIPAA Right of Access / Erasure compliance.
    // -----------------------------------------------------------------------

    match /members/{memberId} {
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.brokerId;

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.brokerId
        && request.resource.data.mbi_number_cipher is string
        && request.resource.data.mbi_number_iv is string
        && request.resource.data.date_of_birth_cipher is string
        && request.resource.data.date_of_birth_iv is string
        && request.resource.data.phone_number_cipher is string
        && request.resource.data.phone_number_iv is string;

      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.brokerId
        && request.auth.uid == request.resource.data.brokerId;

      // Deletion blocked — use soft-delete via status field or Admin SDK.
      allow delete: if false;

      // status_history — append-only ledger of plan transitions.
      // brokerId is denormalized into each entry to avoid cross-doc reads
      // in rule evaluation.
      match /status_history/{entryId} {
        allow read: if isAuthenticated()
          && request.auth.uid == resource.data.brokerId;

        // Client may append an entry only if it matches the parent member's broker.
        allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.brokerId;

        // History is immutable — no updates or deletes.
        allow update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // risk_events — written exclusively by onCrmUpdate / onClientRiskChange.
    // Brokers can read their own events; no client writes permitted.
    // -----------------------------------------------------------------------

    match /risk_events/{eventId} {
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.brokerId;

      allow write: if false; // Admin SDK (Cloud Function) only
    }

    // -----------------------------------------------------------------------
    // retention_events — SMS/call drafts produced by onClientRiskChange.
    // Written by Cloud Function; brokers can read their own drafts.
    // -----------------------------------------------------------------------

    match /retention_events/{eventId} {
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.brokerId;

      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // phi_access_logs — audit trail for PHI signed-URL issuances.
    // Written by getPhiSignedUrl Cloud Function; users may read their own
    // entries for self-audit (HIPAA §164.528 right to accounting of disclosures).
    // -----------------------------------------------------------------------

    match /phi_access_logs/{entryId} {
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.userId
        && request.auth.token.agencyId == resource.data.agencyId;

      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Deny everything else by default.
    // -----------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
